# Credenciais do Databricks - UM arquivo para todos os ambientes.
# Copie para .env (sem extensao) e preencha. O .env esta no .gitignore.
#
# tivio_core/db.py procura nesta ordem:
#   1. .env da pasta do ambiente (se existir, vence)
#   2. .env desta raiz
# Entao rotacionar a chave e mexer em um lugar so.

DATABRICKS_HOST=adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_PATH=/sql/1.0/warehouses/0000000000000000
DATABRICKS_TOKEN=dapi...

# catalogo/schema padrao das queries
DATABRICKS_CATALOG=marketdata
DATABRICKS_SCHEMA=silver

# true = dados ficticios, nao conecta
USE_MOCK=false
