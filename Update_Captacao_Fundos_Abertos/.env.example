# Liga/desliga o modo de teste sem banco.
#   true  = usa dados ficticios (para validar o pipeline)
#   false = conecta no Databricks de verdade
USE_MOCK=true

# --- Credenciais Databricks (mesmas do Monitor de Novos Fundos) ---
DATABRICKS_HOST=adb-2905561991608053.13.azuredatabricks.net
DATABRICKS_PATH=/sql/1.0/warehouses/9636f7bb0ab55ff6
DATABRICKS_TOKEN=coloque_seu_personal_access_token_aqui

# --- CDI de referencia por competencia (fracao decimal) ---
# Ex.: 1.13% -> 0.0113   |   14.82% -> 0.1482   |   5.72% -> 0.0572
CDI_MES=0.0113
CDI_12M=0.1482
CDI_YTD=0.0572
