# =====================================================================
# .env.example  ->  copie para .env e preencha
# NUNCA versione o .env (guarda o token). Pode reutilizar o token do
# Monitor de Novos Fundos / Captacao Fundos Abertos.
# =====================================================================

# true  = usa dados ficticios (valida o pipeline sem banco)
# false = conecta no Databricks de verdade
USE_MOCK=true

DATABRICKS_HOST=adb-XXXXXXXX.azuredatabricks.net
DATABRICKS_PATH=/sql/1.0/warehouses/XXXXXXXX
DATABRICKS_TOKEN=coloque_seu_token_aqui
